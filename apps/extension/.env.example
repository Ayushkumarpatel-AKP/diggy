# Copy to `.env` only if you need build-time overrides.
#
# NOTHING SECRET BELONGS HERE. Everything in this file is inlined into the
# built extension, so any key placed here ships inside the bundle and leaks to
# anyone who opens it. API keys are entered at runtime in Diggy's Settings (⚙)
# and stored in the browser profile, never in a build artefact.

# Which brain to prefer when both keys are present: groq | nvidia
VITE_DEFAULT_PROVIDER=groq

# Optional default for the official Google sign-in.
# This is a PUBLIC client id (not a secret) — it is the "Web application" OAuth
# client used by the chrome.identity popup flow. Users may override it in
# Settings. Add this exact redirect URI to the client in Google Cloud:
#   https://<your-extension-id>.chromiumapp.org/
VITE_GOOGLE_CLIENT_ID=
